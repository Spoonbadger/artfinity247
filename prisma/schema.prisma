generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id              String      @id @default(cuid())
  stripeSessionId String      @unique
  email           String
  amountTotal     Int
  currency        String
  paymentStatus   String
  createdAt       DateTime    @default(now())
  shippingName    String?
  shippingAddress String?
  receiptSentAt   DateTime?
  shippingStatus  String      @default("pending")
  items           OrderItem[]
  sentToPrinter Boolean @default(false)
  adminNotificationSentAt  DateTime?
  // retail = a buyer's order; bulk = an artist ordering their own prints at cost to sell in person
  kind            String  @default("retail")
  bulkArtistId    String?
  artistNotificationsSentAt DateTime?
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  artworkId    String?
  slug         String?
  size         String?
  frameChosen  Boolean @default(false)
  frameColor   String?
  unitPrice    Int?
  quantity     Int?
  lineTotal    Int?
  title        String?
  artistName   String?
  imageUrl     String?
  laborCost    Int?
  printCost    Int?
  shippingCost Int?
  websiteCost  Int?
  editionNumber Int?     // e.g. 12 of 50 for limited editions
  qrCodeId      String?  // the printed code that led to this sale (scan attribution)
  artistSplit   Float?   // the artist's share of profit locked in when the order was placed (0.6 free, higher on Pro)
  artwork      Artwork? @relation(fields: [artworkId], references: [id])
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([artworkId])
}

model Payout {
  id          String    @id @default(cuid())
  artistId    String
  month       String
  amountCents Int
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  artist      Artist    @relation(fields: [artistId], references: [id])

  @@unique([artistId, month])
}

model Artist {
  id           String    @id @default(cuid())
  name         String    // here for backwards compatability - delete later
  first_name   String?
  last_name    String?
  artist_name  String?
  email        String    @unique
  password     String
  profileImage String?
  phone        String
  city         String
  citySlug     String    @default("")
  state        String?
  country      String?
  slug         String    @unique
  bio          String?   @default("")
  createdAt    DateTime  @default(now())
  role         Role      @default(USER)
  venmoHandle  String?   @unique
  artworks     Artwork[]
  payouts      Payout[]

  // Real verification (reviewed by an admin), not automatic
  verification            VerificationStatus @default(NONE)
  verifiedAt              DateTime?
  verificationRequestedAt DateTime?
  verificationEvidence    Json?    // { instagram, website, portfolio, note } submitted by the artist
  verificationNote        String?  // admin's note, e.g. why a request was declined

  // Customization
  pageTheme        Json?    // artist page design: accent, banner artwork, layout, pinned ids
  linksTheme       Json?    // /@handle/links design: background artwork, button style, colors
  links            ArtistLink[]
  messages         Message[]
  emailTemplates   EmailTemplate[]
  collections      Collection[]
  qrCodes          QrCode[]

  // Legal: when the artist accepted the Artist Terms and Terms & Conditions
  termsAcceptedAt  DateTime?

  // Plans and referrals (billing comes with the backend)
  plan             Plan      @default(FREE)
  proUntil         DateTime? // Pro is active while this is in the future (paid or earned by referrals)
  referralCode     String?   @unique
  referredById     String?

  passwordResetTokens PasswordResetToken[]

  @@index([citySlug])
}

model Artwork {
  id           String      @id @default(cuid())
  title        String
  slug         String?     @unique
  description  String
  imageUrl     String
  markupSmall  Int?        @default(0)
  markupMedium Int?        @default(0)
  markupLarge  Int?        @default(0)
  markupXl     Int?        @default(0)
  artistId     String
  createdAt    DateTime    @default(now())
  artist       Artist      @relation(fields: [artistId], references: [id])
  OrderItem    OrderItem[]
  status        ArtworkStatus @default(PENDING)
  sensitive     String[]      @default([])
  // Limited print runs: null = open edition. editionSize counts prints across all sizes, numbered 1..N.
  editionSize   Int?
  // Room previews on the buy page: scene numbers (0-999) the artist picked; empty = auto-picked
  roomScenes    Int[]         @default([])
  collectionItems CollectionItem[]
  qrCodes         QrCode[]
  flaggedReason String?
  flaggedBy     String?
}

enum ArtworkStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  USER
  ADMIN
}


model PasswordResetToken {
  id        String   @id @default(cuid())
  artistId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
}


enum VerificationStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

// Socials and link-in-bio links. kind: instagram | tiktok | youtube | facebook | x | pinterest | threads | website | email | custom
model ArtistLink {
  id        String   @id @default(cuid())
  artistId  String
  kind      String
  label     String?
  url       String
  position  Int      @default(0)
  active    Boolean  @default(true)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, position])
}

// Artist <-> customer communications log: thank-you notes, messages, private notes
// direction: out (artist to buyer) | in (buyer to artist) | note (private)
model Message {
  id        String    @id @default(cuid())
  artistId  String
  email     String
  orderId   String?
  direction String
  subject   String?
  body      String
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  artist    Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, email])
}

// An artist's own wording for the automated emails. kind: receipt | shipped | delivered | thank_you
model EmailTemplate {
  id        String   @id @default(cuid())
  artistId  String
  kind      String
  subject   String
  body      String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, kind])
}


// An artist's own groupings of their work, sorted by hand (e.g. "Blue Ridge series", "Small works").
model Collection {
  id          String           @id @default(cuid())
  artistId    String
  title       String
  slug        String
  description String?          @default("")
  coverArtworkId String?
  position    Int              @default(0)
  createdAt   DateTime         @default(now())
  artist      Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  items       CollectionItem[]

  @@unique([artistId, slug])
  @@index([artistId, position])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  artworkId    String
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  artwork      Artwork    @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([collectionId, artworkId])
  @@index([collectionId, position])
}


enum Plan {
  FREE
  PRO
}


// A printed code. It holds only a short link (/q/<code>); everything below is editable after printing.
model QrCode {
  id          String      @id @default(cuid())
  code        String      @unique // short, upper-case, no look-alike characters, e.g. K7P2
  artistId    String
  artworkId   String?     // null = the code opens the artist's page
  label       String?     // the artist's own name for it, e.g. "Lumen Cafe wall"
  venue       String?     // shown as "You scanned this at ..."
  discountPct Int?        // 5-30, applied at checkout
  design      Json?       // the QR Studio design it was printed with
  active      Boolean     @default(true)
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  artist      Artist      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  artwork     Artwork?    @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  scans       ScanEvent[]

  @@index([artistId])
}

// One scan of a printed code. No personal data: coarse device and place only.
model ScanEvent {
  id        String   @id @default(cuid())
  qrCodeId  String
  createdAt DateTime @default(now())
  device    String?  // phone | tablet | desktop
  city      String?
  region    String?
  country   String?
  visitorId String?  // random first-party id, for unique scans and joining scans to orders
  qrCode    QrCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId, createdAt])
}
