generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id              String      @id @default(cuid())
  stripeSessionId String      @unique
  email           String
  amountTotal     Int
  currency        String
  paymentStatus   String
  createdAt       DateTime    @default(now())
  shippingName    String?
  shippingAddress String?
  receiptSentAt   DateTime?
  shippingStatus  String      @default("pending")
  items           OrderItem[]
  sentToPrinter Boolean @default(false)
  // When the work order went to the print lab automatically, and the lab's reference if it sends one back
  printerSentAt DateTime?
  printerRef    String?
  // Shipping, set by admin, the lab, or a carrier-tracking webhook
  trackingCarrier String?
  trackingNumber  String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  adminNotificationSentAt  DateTime?
  // retail = a buyer's order; bulk = an artist ordering their own prints at cost to sell in person
  kind            String  @default("retail")
  bulkArtistId    String?
  artistNotificationsSentAt DateTime?
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  artworkId    String?
  slug         String?
  size         String?
  frameChosen  Boolean @default(false)
  frameColor   String?
  unitPrice    Int?
  quantity     Int?
  lineTotal    Int?
  title        String?
  artistName   String?
  imageUrl     String?
  laborCost    Int?
  printCost    Int?
  shippingCost Int?
  websiteCost  Int?
  editionNumber Int?     // e.g. 12 of 50 for limited editions
  qrCodeId      String?  // the printed code that led to this sale (scan attribution)
  artistSplit   Float?   // the artist's share of profit locked in when the order was placed (0.6 free, higher on Pro)
  review        Review?
  artwork      Artwork? @relation(fields: [artworkId], references: [id])
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([artworkId])
}

model Payout {
  id          String    @id @default(cuid())
  artistId    String
  month       String
  amountCents Int
  paidAt      DateTime?
  method      String?   // "stripe" | "venmo" | "manual"
  stripeTransferId String? @unique
  failureReason    String?
  createdAt   DateTime  @default(now())
  artist      Artist    @relation(fields: [artistId], references: [id])

  @@unique([artistId, month])
}

model Artist {
  id           String    @id @default(cuid())
  name         String    // here for backwards compatability - delete later
  first_name   String?
  last_name    String?
  artist_name  String?
  email        String    @unique
  password     String?   // null for accounts created with Google/Apple/Instagram/etc.
  profileImage String?
  phone        String
  city         String
  citySlug     String    @default("")
  state        String?
  country      String?
  slug         String    @unique
  bio          String?   @default("")
  createdAt    DateTime  @default(now())
  role         Role      @default(USER)
  venmoHandle  String?   @unique
  // Automatic payouts through Stripe Connect (Express). Venmo stays as the fallback.
  stripeAccountId       String?  @unique
  stripePayoutsEnabled  Boolean  @default(false)
  artworks     Artwork[]
  payouts      Payout[]

  // Real verification (reviewed by an admin), not automatic
  verification            VerificationStatus @default(NONE)
  verifiedAt              DateTime?
  verificationRequestedAt DateTime?
  verificationEvidence    Json?    // { instagram, website, portfolio, note } submitted by the artist
  verificationNote        String?  // admin's note, e.g. why a request was declined

  // Customization
  pageTheme        Json?    // artist page design: accent, banner artwork, layout, pinned ids
  linksTheme       Json?    // /@handle/links design: background artwork, button style, colors
  links            ArtistLink[]
  messages         Message[]
  emailTemplates   EmailTemplate[]
  collections      Collection[]
  qrCodes          QrCode[]

  // Legal: when the artist accepted the Artist Terms and Terms & Conditions
  termsAcceptedAt  DateTime?

  // Plans and referrals (billing comes with the backend)
  plan             Plan      @default(FREE)
  proUntil         DateTime? // Pro is active while this is in the future (paid or earned by referrals)
  referralCode     String?   @unique
  referredById     String?

  passwordResetTokens PasswordResetToken[]

  // Payouts: a Venmo change waits for the artist to confirm it from their email
  venmoPending       String?
  venmoPendingToken  String?   @unique
  venmoPendingAt     DateTime?
  // Account closing: the page goes offline right away; unpaid earnings are still paid out before the data is removed
  closedAt           DateTime?
  // Admin can pause an account (page offline, no new sales) without closing it
  oauthAccounts      OAuthAccount[]
  // Set when the artist clicks the confirm link in their email, or signs in with a provider that verified it
  emailVerifiedAt    DateTime?
  emailVerifyToken   String?   @unique
  // Bumped to sign out every existing session (password reset, account takeover fix)
  sessionVersion     Int       @default(0)
  // Admin team: owner | admin | support (null for artists). Support can't touch money or other admins.
  adminRole          String?
  // Which admin alerts this admin gets, and how: { "<kind>": "instant" | "digest" | "off" }
  adminNotify        Json?
  suspendedAt        DateTime?
  suspendedReason    String?
  events             StudioEvent[]
  reviews            Review[]
  followers          Follower[]
  newsletters        Newsletter[]

  @@index([citySlug])
}

model Artwork {
  id           String      @id @default(cuid())
  title        String
  slug         String?     @unique
  description  String
  imageUrl     String
  markupSmall  Int?        @default(0)
  markupMedium Int?        @default(0)
  markupLarge  Int?        @default(0)
  markupXl     Int?        @default(0)
  artistId     String
  createdAt    DateTime    @default(now())
  artist       Artist      @relation(fields: [artistId], references: [id])
  OrderItem    OrderItem[]
  status        ArtworkStatus @default(PENDING)
  sensitive     String[]      @default([])
  // Limited print runs: null = open edition. editionSize counts prints across all sizes, numbered 1..N.
  editionSize   Int?
  // Room previews on the buy page: scene numbers (0-999) the artist picked; empty = auto-picked
  roomScenes    Int[]         @default([])
  collectionItems CollectionItem[]
  qrCodes         QrCode[]
  flaggedReason String?
  flaggedBy     String?
  // Print sizes this file is sharp enough for (small/medium/large/xl). Empty = not checked (older uploads).
  printableSizes String[]     @default([])
  // Rights: when the artist confirmed "this is my original work and I hold the rights"
  ownershipConfirmedAt DateTime?
  reports         ArtReport[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  // Perceptual fingerprint (dHash, 16 hex chars) of the original, to catch re-uploads of the same image
  imageHash       String?
  @@index([imageHash])
}

enum ArtworkStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  USER
  ADMIN
}


model PasswordResetToken {
  id        String   @id @default(cuid())
  artistId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId])
}


enum VerificationStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

// Socials and link-in-bio links. kind: instagram | tiktok | youtube | facebook | x | pinterest | threads | website | email | custom
model ArtistLink {
  id        String   @id @default(cuid())
  artistId  String
  kind      String
  label     String?
  url       String
  position  Int      @default(0)
  active    Boolean  @default(true)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, position])
}

// Artist <-> customer communications log: thank-you notes, messages, private notes
// direction: out (artist to buyer) | in (buyer to artist) | note (private)
model Message {
  id        String    @id @default(cuid())
  artistId  String
  email     String
  orderId   String?
  direction String
  subject   String?
  body      String
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  artist    Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, email])
}

// An artist's own wording for the automated emails. kind: receipt | shipped | delivered | thank_you
model EmailTemplate {
  id        String   @id @default(cuid())
  artistId  String
  kind      String
  subject   String
  body      String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, kind])
}


// An artist's own groupings of their work, sorted by hand (e.g. "East River series", "Small works").
model Collection {
  id          String           @id @default(cuid())
  artistId    String
  title       String
  slug        String
  description String?          @default("")
  coverArtworkId String?
  position    Int              @default(0)
  createdAt   DateTime         @default(now())
  artist      Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  items       CollectionItem[]

  @@unique([artistId, slug])
  @@index([artistId, position])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  artworkId    String
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  artwork      Artwork    @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([collectionId, artworkId])
  @@index([collectionId, position])
}


enum Plan {
  FREE
  PRO
}


// A printed code. It holds only a short link (/q/<code>); everything below is editable after printing.
model QrCode {
  id          String      @id @default(cuid())
  code        String      @unique // short, upper-case, no look-alike characters, e.g. K7P2
  artistId    String
  artworkId   String?     // null = the code opens the artist's page
  label       String?     // the artist's own name for it, e.g. "Lumen Cafe wall"
  venue       String?     // shown as "You scanned this at ..."
  discountPct Int?        // 5-30, applied at checkout
  design      Json?       // the QR Studio design it was printed with
  active      Boolean     @default(true)
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  // The venue partner this code hangs at (cafe, shop, market), for venue revenue share
  venueId     String?
  venuePartner Venue?     @relation(fields: [venueId], references: [id], onDelete: SetNull)
  artist      Artist      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  artwork     Artwork?    @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  scans       ScanEvent[]

  @@index([artistId])
}

// One scan of a printed code. No personal data: coarse device and place only.
model ScanEvent {
  id        String   @id @default(cuid())
  qrCodeId  String
  createdAt DateTime @default(now())
  device    String?  // phone | tablet | desktop
  city      String?
  region    String?
  country   String?
  visitorId String?  // random first-party id, for unique scans and joining scans to orders
  qrCode    QrCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId, createdAt])
}

// Studio events (markets, open studios). Shown on the artist page and used to tag QR scans.
model StudioEvent {
  id        String   @id @default(cuid())
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  name      String
  venue     String   @default("")
  start     String   // YYYY-MM-DD
  end       String   // YYYY-MM-DD
  createdAt DateTime @default(now())

  @@index([artistId, start])
}

// Copyright / rights reports from the public "Report this art" page
model ArtReport {
  id          String   @id @default(cuid())
  artworkId   String?
  artwork     Artwork? @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  artworkUrl  String   @default("")
  reason      String   // "copyright" | "ai" | "offensive" | "other"
  details     String   @default("")
  name        String
  email       String
  isRightsHolder Boolean @default(false)
  status      String   @default("open") // open | removed | dismissed
  adminNote   String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@index([status, createdAt])
}

// Buyer reviews: one per purchased print, left after delivery (verified purchase only)
model Review {
  id          String    @id @default(cuid())
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  artworkId   String?
  artwork     Artwork?  @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  artistId    String
  artist      Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  rating      Int       // 1-5
  body        String    @default("")
  buyerName   String    // shown as first name + last initial
  buyerCity   String?
  photoUrl    String?   // optional photo of the print on their wall
  status      String    @default("published") // published | hidden (admin) | flagged
  artistReply String?
  artistReplyAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([artworkId, status])
  @@index([artistId, status])
}

// Email follows: a buyer or fan follows an artist and gets their newsletter (double opt-in)
model Follower {
  id          String    @id @default(cuid())
  artistId    String
  artist      Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  email       String
  name        String?
  source      String    @default("page") // page | checkout | links | import
  token       String    @unique          // confirm + unsubscribe links
  confirmedAt DateTime?
  unsubscribedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([artistId, email])
  @@index([artistId, confirmedAt])
}

// A newsletter an artist writes and sends to confirmed followers
model Newsletter {
  id         String    @id @default(cuid())
  artistId   String
  artist     Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  subject    String
  body       String    // markdown-lite text
  artworkIds String[]  @default([])
  sentAt     DateTime?
  recipients Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([artistId, createdAt])
}

// Page views for artist analytics (no personal data: a random visitor cookie, referrer host, utm source)
model PageView {
  id        String   @id @default(cuid())
  path      String
  artistId  String?
  artworkId String?
  source    String   @default("direct") // qr | instagram | tiktok | facebook | pinterest | email | search | other site host | direct
  referrer  String?  // host only
  visitorId String?
  device    String?  // mobile | desktop | tablet
  createdAt DateTime @default(now())

  @@index([artistId, createdAt])
  @@index([artworkId, createdAt])
}

// Audit log: every admin action (approve, take down, refund, payout, suspend...), so there's a record of who did what
model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  action     String   // e.g. "artwork.approve", "order.refund", "artist.suspend"
  targetType String   // artist | artwork | order | review | report | payout | reprint | setting
  targetId   String?
  summary    String   @default("")
  details    Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

// Notes admins leave on an artist or order (support history)
model AdminNote {
  id         String   @id @default(cuid())
  targetType String   // artist | order
  targetId   String
  adminEmail String
  body       String
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

// Social sign-in (Google, Apple, Instagram, Facebook...) linked to an artist account
model OAuthAccount {
  id                String   @id @default(cuid())
  artistId          String
  artist            Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  provider          String   // google | apple | instagram | facebook
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())
  lastUsedAt        DateTime?

  @@unique([provider, providerAccountId])
  @@index([artistId])
}

// Invite someone to the admin team by email
model AdminInvite {
  id         String    @id @default(cuid())
  email      String
  role       String    // owner | admin | support
  token      String    @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

// Something that needs an admin. One row per thing (key), so the same issue never emails twice.
model AdminAlert {
  id         String    @id @default(cuid())
  kind       String    // report | reprint | duplicate | review_flagged | verification | work_order_failed | payout_late | payout_failed | order_stuck | job_failed ...
  key        String    @unique // e.g. "report:<id>"
  title      String
  link       String    @default("")
  severity   String    @default("normal") // urgent | normal | low
  createdAt  DateTime  @default(now())
  emailedAt  DateTime?
  digestedAt DateTime?
  resolvedAt DateTime?

  @@index([resolvedAt, createdAt])
}

// Log of background jobs (payout run, digests, retries, tracking sync...)
model JobRun {
  id         String    @id @default(cuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  summary    String    @default("")
  details    Json?

  @@index([job, startedAt])
}

// A buyer's account: passwordless (email link). Orders are matched by email.
model Collector {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  wishlist   WishlistItem[]
}

model WishlistItem {
  id          String    @id @default(cuid())
  collectorId String
  collector   Collector @relation(fields: [collectorId], references: [id], onDelete: Cascade)
  artworkId   String
  artwork     Artwork   @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([collectorId, artworkId])
}

// A cafe, shop or market that hosts artists' codes, and may earn a share of sales from its walls
model Venue {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  neighborhood String?
  address      String?
  contactName  String?
  contactEmail String?
  sharePct     Float     @default(0)   // share of Artfinity's profit on sales from this venue's codes, e.g. 0.05
  active       Boolean   @default(true)
  notes        String?
  createdAt    DateTime  @default(now())
  codes        QrCode[]
}
