# Copy to .env for local development. Stripe, Resend and Cloudinary keys are optional:
# without them checkout runs in test mode, emails print to the terminal, and uploads save to public/uploads.
DATABASE_URL="postgresql://artfinity:artfinity@localhost:5432/artfinity"
JWT_SECRET="local-dev-secret-change-me-0123456789abcdef"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Without STRIPE_SECRET_KEY, checkout records test orders (no payment). That is off in production
# unless this is set to 1 (only for a staging site):
# ALLOW_TEST_CHECKOUT=1
# RESEND_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Signs scan discounts inside QR codes (falls back to JWT_SECRET)
# SCAN_SIGNING_SECRET=

# Social sign-in (see AUTH_SETUP.md). Each "Continue with ..." button shows only when its vars are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# META_GRAPH_VERSION=v23.0
# Dev only: a "Continue with Mock" button to test sign-in flows without keys. Ignored in production.
# ALLOW_MOCK_OAUTH=1

# Bearer secret Vercel sends to /api/cron/* (payouts, admin-digest, sweep)
CRON_SECRET=

# Background jobs (lib/jobs, /admin/jobs). Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"; without it no
# job runs on schedule ("Run now" on /admin/jobs still works).
# CRON_SECRET=
# Carrier tracking (lib/shipping): one of these, plus the webhook secret. Webhook URL: /api/shipping/webhook
# (Shippo: append ?token=<SHIPPING_WEBHOOK_SECRET>; EasyPost: set it as the webhook's HMAC secret).
# Without a key, development has a mock: POST /api/shipping/mock {"orderId","status":"in_transit"|"delivered"}.
# SHIPPO_API_KEY=
# EASYPOST_API_KEY=
# SHIPPING_WEBHOOK_SECRET=
# Reprints: a buyer's first request with a photo on an order up to this total (dollars) is approved automatically. 0 = off.
# REPRINT_AUTO_MAX=150
# Who gets the monthly bookkeeping CSV (comma-separated). Default: the owners on the admin team.
# BOOKKEEPING_EMAIL=
