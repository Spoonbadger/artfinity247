# Copy to .env for local development. Stripe, Resend and Cloudinary keys are optional:
# without them checkout runs in test mode, emails print to the terminal, and uploads save to public/uploads.
DATABASE_URL="postgresql://artfinity:artfinity@localhost:5432/artfinity"
JWT_SECRET="local-dev-secret-change-me-0123456789abcdef"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Without STRIPE_SECRET_KEY, checkout records test orders (no payment). That is off in production
# unless this is set to 1 (only for a staging site):
# ALLOW_TEST_CHECKOUT=1

# Infinity billing (Stripe Billing; see BILLING_SETUP.md). Without STRIPE_SECRET_KEY, /studio/infinity runs a
# simulated subscription (test buttons) on localhost or staging, never on a production deploy.
# Signing secret of the /api/webhook/billing endpoint (subscription + invoice events):
# STRIPE_BILLING_WEBHOOK_SECRET=
# Monthly Price id; without it Checkout uses an inline monthly price from lib/plans.ts (PRO.priceCents):
# STRIPE_INFINITY_PRICE_ID=
# Optional yearly Price id; the yearly option only shows when this is set:
# STRIPE_INFINITY_YEARLY_PRICE_ID=
# Optional named Customer Portal configuration (bpc_...):
# STRIPE_PORTAL_CONFIGURATION_ID=
# Optional: "off" disables automatic tax on subscriptions only; tax code for the inline price:
# STRIPE_BILLING_TAX=
# STRIPE_INFINITY_TAX_CODE=txcd_10103001
# Optional overrides for lib/plans.ts PRO (rebuild after changing; keep the price equal to the Stripe Price):
# NEXT_PUBLIC_INFINITY_PRICE_CENTS=2000
# NEXT_PUBLIC_INFINITY_YEARLY_MONTHLY_CENTS=1600
# NEXT_PUBLIC_INFINITY_SPLIT=0.7
# RESEND_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Signs scan discounts inside QR codes (falls back to JWT_SECRET)
# SCAN_SIGNING_SECRET=

# Social sign-in (see AUTH_SETUP.md). Each "Continue with ..." button shows only when its vars are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# META_GRAPH_VERSION=v23.0
# Dev only: a "Continue with Mock" button to test sign-in flows without keys. Ignored in production.
# ALLOW_MOCK_OAUTH=1

# Bearer secret Vercel sends to /api/cron/* (payouts, admin-digest, sweep)
CRON_SECRET=

# Background jobs (lib/jobs, /admin/jobs). Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"; without it no
# job runs on schedule ("Run now" on /admin/jobs still works).
# CRON_SECRET=
# Carrier tracking (lib/shipping): one of these, plus the webhook secret. Webhook URL: /api/shipping/webhook
# (Shippo: append ?token=<SHIPPING_WEBHOOK_SECRET>; EasyPost: set it as the webhook's HMAC secret).
# Without a key, development has a mock: POST /api/shipping/mock {"orderId","status":"in_transit"|"delivered"}.
# SHIPPO_API_KEY=
# EASYPOST_API_KEY=
# SHIPPING_WEBHOOK_SECRET=
# Reprints: a buyer's first request with a photo on an order up to this total (dollars) is approved automatically. 0 = off.
# REPRINT_AUTO_MAX=150
# Who gets the monthly bookkeeping CSV (comma-separated). Default: the owners on the admin team.
# BOOKKEEPING_EMAIL=

# Automatic image check on upload (lib/moderation, MODERATION_SETUP.md). Off by default.
# IMAGE_MODERATION_PROVIDER=none   # sightengine | google | aws | mock (dev only, reads file names) | none
# IMAGE_MODERATION_TIMEOUT_MS=6000
# SIGHTENGINE_USER=
# SIGHTENGINE_SECRET=
# SIGHTENGINE_MODELS=nudity-2.1,gore-2.0,offensive-2.0
# GOOGLE_VISION_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ---------------------------------------------------------------------------------------------------------------
# Everything else the code reads (DEPLOY.md lists each with what breaks without it). All optional unless marked.
# ---------------------------------------------------------------------------------------------------------------

# Site address. NEXT_PUBLIC_APP_URL (above) is REQUIRED in production; NEXT_PUBLIC_SITE_URL overrides it for links in
# emails, QR codes and the sitemap if the public domain differs (rebuild after changing NEXT_PUBLIC_* values).
# NEXT_PUBLIC_SITE_URL=https://theartfinity.com

# Stripe extras. Connect webhook (artists' payout accounts, /api/webhook/connect), see BILLING_SETUP.md:
# STRIPE_CONNECT_WEBHOOK_SECRET=
# Sales tax at checkout through Stripe Tax is on by default; "off" turns it off. Product tax code override:
# STRIPE_TAX=off
# STRIPE_TAX_CODE=txcd_99999999

# Email senders and inboxes (Resend; verify theartfinity.com in Resend first). Defaults in brackets.
# RESEND_FROM_EMAIL="Artfinity <no-reply@theartfinity.com>"   # sign-in, account and admin emails
# EMAIL_FROM="Artfinity <contact@theartfinity.com>"           # lib/email.ts and venue statements
# CONTACT_EMAIL=contact@theartfinity.com                      # contact form and admin messages to artists
# REPORTS_EMAIL=                                              # art reports and DMCA notices (falls back to CONTACT_EMAIL)
# ADMIN_NOTIFY_EMAIL=hello@theartfinity.com                   # verification requests

# Print lab work orders (lib/printer.ts). With PRINTER_EMAIL set, every paid order emails the lab a work order.
# Without it in production nothing is sent: tick "Sent to printer" by hand.
# PRINTER_EMAIL=
# PRINTER_PROVIDER=email          # email | none | prodigi (or api with PRINTER_API=prodigi)
# PRINTER_FROM="Artfinity <orders@theartfinity.com>"
# PRINTER_REPLY_TO=
# PRINTER_PAPER=

# Prodigi print lab API (PRINTER_PROVIDER=prodigi; lib/prodigi.ts, DEPLOY.md "Prodigi"). Paid orders and approved
# reprints become Prodigi orders; Prodigi's callbacks and the hourly prodigi-sync job mark them shipped with tracking.
# PRINTER_API=prodigi             # only with PRINTER_PROVIDER=api (same as PRINTER_PROVIDER=prodigi)
# PRODIGI_API_KEY=                # Prodigi dashboard > Settings > API. Sandbox and live have different keys.
# PRODIGI_ENV=sandbox             # sandbox (default: nothing is printed) | live
# PRODIGI_SHIPPING_METHOD=Standard   # Budget | Standard | Express | Overnight
# PRODIGI_WEBHOOK_TOKEN=          # long random string; the callback URL carries it as ?token= (callbacks aren't signed)
# PRODIGI_PACKING_SLIP=off        # on: send our packing slip URL with each order (check it in sandbox first)
# PRODIGI_DASHBOARD_URL=          # only if the admin's "Prodigi ord_…" link goes to the wrong place; {id} = order id
# PRODIGI_API_URL=                # development only: a local mock, e.g. http://localhost:4010
# Size (+ frame colour) -> Prodigi SKU, one line of JSON. Keys: S, M, L, XL (no frame) and S:black ... XL:natural.
# A value is a SKU, or {"sku":"...","attributes":{"color":"..."}}. Values starting with TODO count as missing:
# an order needing one fails with "No Prodigi SKU for ..." in /admin/orders instead of printing the wrong thing.
# TODO(thomas): confirm SKUs in the Prodigi dashboard (product catalogue) for 310gsm smooth matte fine art paper and each frame.
# PRODIGI_SKUS={"S":"TODO-fine-art-310gsm-5x7","M":"TODO-fine-art-310gsm-8x12","L":"TODO-fine-art-310gsm-11x17","XL":"TODO-fine-art-310gsm-18x24","S:black":{"sku":"TODO-framed-5x7","attributes":{"color":"TODO-black"}},"S:white":{"sku":"TODO-framed-5x7","attributes":{"color":"TODO-white"}},"S:natural":{"sku":"TODO-framed-5x7","attributes":{"color":"TODO-natural"}},"M:black":{"sku":"TODO-framed-8x12","attributes":{"color":"TODO-black"}},"M:white":{"sku":"TODO-framed-8x12","attributes":{"color":"TODO-white"}},"M:natural":{"sku":"TODO-framed-8x12","attributes":{"color":"TODO-natural"}},"L:black":{"sku":"TODO-framed-11x17","attributes":{"color":"TODO-black"}},"L:white":{"sku":"TODO-framed-11x17","attributes":{"color":"TODO-white"}},"L:natural":{"sku":"TODO-framed-11x17","attributes":{"color":"TODO-natural"}},"XL:black":{"sku":"TODO-framed-18x24","attributes":{"color":"TODO-black"}},"XL:white":{"sku":"TODO-framed-18x24","attributes":{"color":"TODO-white"}},"XL:natural":{"sku":"TODO-framed-18x24","attributes":{"color":"TODO-natural"}}}

# Business settings that env can pin (env wins over the admin pages):
# TEST_START_DATE=2026-11-01      # 90-day test start (admin dashboard). Set it here on Vercel: the file can't be saved there.
# REFUND_PAID_OUT_POLICY=absorb   # absorb | deduct_next_payout (owner setting on /admin/settings, lib/refundPolicy.ts)
# COLLECTOR_REWARDS=0             # 1 turns on buyer rewards (/admin/settings/rewards); with:
# COLLECTOR_REWARD_EVERY=
# COLLECTOR_REWARD_PCT=
# LEGACY_DISCOUNT_UNTIL=2027-03-01T00:00:00-05:00   # last day old unsigned "?off=" QR discounts are honored

# Maps on artist and venue pages (Google Maps JavaScript API key, restricted to your domain):
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Street address suggestions in address fields (bulk prints, admin venues). Server only: a Google Cloud key with
# "Places API (New)" enabled, restricted to that API (not to a website, the browser never sees it). Billed per
# autocomplete session. Without it, address fields still finish the city, state and ZIP from our own list.
# GOOGLE_MAPS_API_KEY=

# Import from Google Drive / Dropbox in Studio (IMPORT_SETUP.md). Each button shows only when its keys are set.
# NEXT_PUBLIC_GOOGLE_API_KEY=
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_GOOGLE_APP_ID=
# NEXT_PUBLIC_DROPBOX_APP_KEY=
# ALLOW_MOCK_IMPORT=1             # dev only: a fake import source. Ignored in production.

# Moderation extras for AWS (temporary credentials / region alias):
# AWS_SESSION_TOKEN=
# AWS_DEFAULT_REGION=

# Error alerts (Sentry, DEPLOY.md → Sentry). Nothing is sent and next.config.mjs isn't wrapped without a DSN.
# SENTRY_DSN=                     # server + edge
# NEXT_PUBLIC_SENTRY_DSN=         # browser (same DSN is fine)
# SENTRY_ENVIRONMENT=             # defaults to VERCEL_ENV (production / preview)
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# SENTRY_TRACES_SAMPLE_RATE=0.05  # share of requests traced (0 turns tracing off)
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.02
# Source map upload at build time: only when SENTRY_AUTH_TOKEN is set (all three needed):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# One-line alerts for failed jobs and webhooks to a Slack or Discord incoming webhook (works without Sentry):
# ALERT_WEBHOOK_URL=

# Database backups (pnpm db:backup, scripts/backup-db.mjs). Neon's point-in-time restore is the main backup.
# DIRECT_URL=                     # Neon direct (non-pooled) URL: used for migrations on deploy and for backups
# BACKUP_DATABASE_URL=            # overrides what gets dumped (default DIRECT_URL, then DATABASE_URL)
# BACKUP_DIR=backups
# BACKUP_KEEP=14
# BACKUP_S3_BUCKET=               # optional upload to S3 / Cloudflare R2 / Backblaze B2:
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=us-east-1      # "auto" for R2
# BACKUP_S3_ENDPOINT=             # e.g. https://<account>.r2.cloudflarestorage.com (blank = AWS S3)
# BACKUP_S3_PREFIX=artfinity-backups/

# Local only (not needed on Vercel):
# ORIGINALS_DIR=storage/originals # where private originals go without Cloudinary (Cloudinary is required on Vercel)
# SCENES_ADMIN_WRITE=1            # allow /admin/scenes edits on a writable server (dev allows them anyway)
# SCENES_CACHE_DIR=               # room-photo render cache (defaults to .cache/scenes, else the temp folder)
# PEXELS_API_KEY=                 # room photo fetchers (PEXELS_LOCAL_PROMPT.md)
# PEXELS_API_URL=
# PIXABAY_API_KEY=
# PIXABAY_API_URL=
# PORT=3000                       # pnpm local
# A11Y_BASE= A11Y_PASSWORD= A11Y_COLLECTOR_TOKEN=   # pnpm a11y (scripts/a11y.mjs)

# Set by the platform, never by hand: NODE_ENV, NEXT_RUNTIME, NEXT_PHASE, CI, VERCEL_ENV, NEXT_PUBLIC_VERCEL_ENV,
# VERCEL_GIT_COMMIT_SHA.

# Artfinity's own Instagram auto-posting (/admin/social, SOCIAL_SETUP.md). Without these the page runs in manual mode.
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# INSTAGRAM_ACCESS_TOKEN=
# Optional: lets the hourly job read the token's expiry and refresh a 60-day user token (falls back to FACEBOOK_CLIENT_ID/SECRET)
# META_APP_ID=
# META_APP_SECRET=
# Optional: YYYY-MM-DD the token expires, for a warning 7 days before when the job can't read it
# INSTAGRAM_TOKEN_EXPIRES_AT=
