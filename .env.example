# Copy to .env for local development. Stripe, Resend and Cloudinary keys are optional:
# without them checkout runs in test mode, emails print to the terminal, and uploads save to public/uploads.
DATABASE_URL="postgresql://artfinity:artfinity@localhost:5432/artfinity"
JWT_SECRET="local-dev-secret-change-me-0123456789abcdef"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Without STRIPE_SECRET_KEY, checkout records test orders (no payment). That is off in production
# unless this is set to 1 (only for a staging site):
# ALLOW_TEST_CHECKOUT=1
# RESEND_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Signs scan discounts inside QR codes (falls back to JWT_SECRET)
# SCAN_SIGNING_SECRET=
